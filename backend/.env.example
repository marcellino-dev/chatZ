# Ambiente
NODE_ENV=development
PORT=3000

# Banco de dados SQLite
DATABASE_URL=file:./dev.db

# Segurança (gere um valor aleatório com pelo menos 16 caracteres)
JWT_SECRET=troque-por-uma-chave-secreta-com-32-caracteres
JWT_EXPIRES_IN=7d

# Base URL (pra montar URLs de upload)
BASE_URL=http://localhost:3000

# Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=troque-pela-chave-da-evolution
EVOLUTION_INSTANCE=chatz