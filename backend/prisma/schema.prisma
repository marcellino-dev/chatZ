generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==========================
// ENUMS
// ==========================
enum Role {
  ADMIN
  AGENT
  CLIENT
}

enum TicketStatus {
  WAITING
  IN_PROGRESS
  TRANSFERRED
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketChannel {
  WHATSAPP
  WEB
}

enum BotState {
  WAITING_SECTOR
  WAITING_AGENT
  WAITING_ATTENDANCE
  IN_ATTENDANCE
  CLOSED
}

// ==========================
// SETORES
// ==========================
model Sector {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         User[]         @relation("SectorUsers")
  tickets       Ticket[]       @relation("SectorTickets")
  conversations Conversation[]
  transfersTo   Transfer[]     @relation("TransfersToSector")

  @@map("sectors")
}

// ==========================
// USUÁRIOS
// ==========================
model User {
  id        String   @id @default(cuid())
  name      String
  role      Role     @default(CLIENT)
  active    Boolean  @default(true)

  email     String?  @unique
  password  String?
  phone     String?  @unique

  sectorId  String?
  sector    Sector?  @relation("SectorUsers", fields: [sectorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientTickets     Ticket[] @relation("ClientTickets")
  agentTickets      Ticket[] @relation("AgentTickets")
  requestedTickets  Ticket[] @relation("RequestedAgentTickets")

  messages      Message[]
  transfersSent Transfer[] @relation("TransfersFrom")
  transfersRecv Transfer[] @relation("TransfersTo")

  participatedTickets TicketParticipant[] @relation("TicketParticipants")
  addedParticipants   TicketParticipant[] @relation("ParticipantAddedBy")

  @@map("users")
}

// ==========================
// CONTATOS
// ==========================
model Contact {
  id              String   @id @default(cuid())
  name            String
  phone           String
  normalizedPhone String   @unique
  company         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("contacts")
}

// ==========================
// TICKETS
// ==========================
model Ticket {
  id        String         @id @default(cuid())
  subject   String
  status    TicketStatus   @default(WAITING)
  priority  TicketPriority @default(MEDIUM)
  channel   TicketChannel  @default(WHATSAPP)

  sectorId  String
  sector    Sector         @relation("SectorTickets", fields: [sectorId], references: [id])

  clientId  String
  client    User           @relation("ClientTickets", fields: [clientId], references: [id])

  requestedAgentId String?
  requestedAgent   User?   @relation("RequestedAgentTickets", fields: [requestedAgentId], references: [id])

  agentId   String?
  agent     User?          @relation("AgentTickets", fields: [agentId], references: [id])

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  closedAt  DateTime?

  messages      Message[]
  transfers     Transfer[]
  conversation  Conversation?
  participants  TicketParticipant[]

  @@map("tickets")
}

// ==========================
// PARTICIPANTES DO TICKET
// ==========================
model TicketParticipant {
  id        String   @id @default(cuid())

  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation("TicketParticipants", fields: [userId], references: [id], onDelete: Cascade)

  addedById String?
  addedBy   User?    @relation("ParticipantAddedBy", fields: [addedById], references: [id])

  createdAt DateTime @default(now())

  @@unique([ticketId, userId])
  @@map("ticket_participants")
}

// ==========================
// MENSAGENS
// ==========================
model Message {
  id         String   @id @default(cuid())
  content    String   @default("")
  read       Boolean  @default(false)
  attachment Json?

  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  senderId   String
  sender     User     @relation(fields: [senderId], references: [id])

  createdAt  DateTime @default(now())

  @@map("messages")
}

// ==========================
// CONVERSAS
// ==========================
model Conversation {
  id        String    @id @default(cuid())
  phone     String    @unique
  state     BotState  @default(WAITING_SECTOR)

  sectorId  String?
  sector    Sector?   @relation(fields: [sectorId], references: [id])

  ticketId  String?   @unique
  ticket    Ticket?   @relation(fields: [ticketId], references: [id])

  context   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("conversations")
}

// ==========================
// TRANSFERÊNCIAS
// ==========================
model Transfer {
  id         String   @id @default(cuid())
  reason     String?

  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  fromUserId String
  fromUser   User     @relation("TransfersFrom", fields: [fromUserId], references: [id])

  toUserId   String?
  toUser     User?    @relation("TransfersTo", fields: [toUserId], references: [id])

  toSectorId String?
  toSector   Sector?  @relation("TransfersToSector", fields: [toSectorId], references: [id])

  createdAt  DateTime @default(now())

  @@map("transfers")
}